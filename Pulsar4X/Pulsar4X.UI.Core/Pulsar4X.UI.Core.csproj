<Project Sdk="Microsoft.NET.Sdk">

  <!-- Platform-neutral view models for the Avalonia UI. Talks to the game only through
       Pulsar4X.Api (IGameClient), never the engine, and references no Avalonia packages, so
       desktop and a future mobile head can share it unchanged. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Pulsar4X.UI.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Pulsar4X.UI.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pulsar4X.Api\Pulsar4X.Api.csproj" />
    <!-- Pure orbital math (no engine): propagates OrbitView elements between server pushes. -->
    <ProjectReference Include="..\Pulsar4X.OrbitalMath\Pulsar4X.Orbital.csproj" />
  </ItemGroup>

</Project>
