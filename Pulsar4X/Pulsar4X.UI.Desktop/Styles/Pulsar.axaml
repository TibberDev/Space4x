<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Shared look for the Pulsar4X desktop UI. Colours live here so later theming is one file. -->
  <Styles.Resources>
    <SolidColorBrush x:Key="PulsarBackground" Color="#0E1117" />
    <SolidColorBrush x:Key="PulsarPanel" Color="#161B22" />
    <SolidColorBrush x:Key="PulsarBorder" Color="#2A313C" />
    <SolidColorBrush x:Key="PulsarAccent" Color="#58A6FF" />
    <SolidColorBrush x:Key="PulsarMuted" Color="#8B949E" />
    <SolidColorBrush x:Key="PulsarError" Color="#F85149" />
    <SolidColorBrush x:Key="PulsarWarning" Color="#D29922" />
    <SolidColorBrush x:Key="PulsarSuccess" Color="#3FB950" />
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{StaticResource PulsarBackground}" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{StaticResource PulsarPanel}" />
    <Setter Property="BorderBrush" Value="{StaticResource PulsarBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="TextBlock.heading">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PulsarMuted}" />
    <Setter Property="Margin" Value="12,10,12,6" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{StaticResource PulsarMuted}" />
  </Style>

  <Style Selector="TextBlock.date">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- Floating controls over the star map -->
  <Style Selector="Button.map">
    <Setter Property="Background" Value="#CC161B22" />
    <Setter Property="BorderBrush" Value="{StaticResource PulsarBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,4" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.mapchip">
    <Setter Property="Background" Value="#CC161B22" />
    <Setter Property="BorderBrush" Value="{StaticResource PulsarBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Cards and simple tables used across the management screens -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{StaticResource PulsarPanel}" />
    <Setter Property="BorderBrush" Value="{StaticResource PulsarBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="14,10" />
  </Style>

  <Style Selector="TextBlock.cardtitle">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Grid.tablehead">
    <Setter Property="Margin" Value="0,4,0,2" />
  </Style>
  <Style Selector="Grid.tablehead > TextBlock">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource PulsarMuted}" />
  </Style>

  <Style Selector=":is(Panel).tablerow">
    <Setter Property="Margin" Value="0,3" />
  </Style>
  <Style Selector="Grid.tablerow > TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBlock.warning">
    <Setter Property="Foreground" Value="{StaticResource PulsarWarning}" />
  </Style>
  <Style Selector="TextBlock.error">
    <Setter Property="Foreground" Value="{StaticResource PulsarError}" />
  </Style>
  <!-- A trait that is not average: the ones that shape this person. -->
  <Style Selector="TextBlock.notable">
    <Setter Property="Foreground" Value="{StaticResource PulsarAccent}" />
  </Style>
  <Style Selector="TextBlock.success">
    <Setter Property="Foreground" Value="{StaticResource PulsarSuccess}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Foreground" Value="{StaticResource PulsarError}" />
  </Style>
  <Style Selector="Button.small">
    <Setter Property="Padding" Value="10,3" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <Style Selector="ListBox.compact ListBoxItem">
    <Setter Property="Padding" Value="8,4" />
  </Style>
</Styles>
