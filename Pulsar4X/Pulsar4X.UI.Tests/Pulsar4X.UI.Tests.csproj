<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests for the Avalonia UI: view-model tests against a real in-process game, and headless
       window tests that render real frames (Skia) to PNG under TestResults/Screenshots. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CS9057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="NUnit" Version="4.5.1" />
    <PackageReference Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageReference Include="Avalonia.Headless.NUnit" Version="12.1.6" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.6" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pulsar4X.UI.Desktop\Pulsar4X.UI.Desktop.csproj" />
  </ItemGroup>

</Project>
